    protected function normalizeConfigCanonical($value): array
    {
        $defaults = $this->defaultConfigCanonical();

        if (!is_array($value)) {
            return $defaults;
        }

        $commonModules = $this->stringArray($value['common_modules'] ?? [], 200, 255);
        $paymentTopics = $this->stringArray($value['payment_topics'] ?? [], 200, 255);
        $statuses = $this->stringArray($value['unified_statuses'] ?? [], 100, 255);

        if (!$commonModules) {
            $commonModules = $defaults['common_modules'];
        }

        if (!$paymentTopics) {
            $paymentTopics = $defaults['payment_topics'];
        }

        if (!$statuses) {
            $statuses = $defaults['unified_statuses'];
        }

        $reasons = [];
        $seen = [];

        foreach ((array) ($value['reasons'] ?? []) as $reasonRaw) {
            $reason = $this->normalizeReasonCanonical($reasonRaw);

            if ($reason === null || isset($seen[$reason['k']])) {
                continue;
            }

            $seen[$reason['k']] = true;
            $reasons[] = $reason;
        }

        if (!$reasons) {
            $reasons = $defaults['reasons'];
        }

        return [
            'version' => 1,
            'common_modules' => $commonModules,
            'payment_topics' => $paymentTopics,
            'unified_statuses' => $statuses,
            'reasons' => $reasons,
        ];
    }

    protected function normalizeReasonCanonical($value): ?array
    {
        if (!is_array($value)) {
            return null;
        }

        $key = strtolower(trim((string) ($value['k'] ?? '')));
        $label = trim((string) ($value['l'] ?? ''));
        $moduleSet = strtolower(trim((string) ($value['module_set'] ?? ($value['moduleSet'] ?? 'common'))));
        $moduleTitle = trim((string) ($value['module_title'] ?? ($value['mTitle'] ?? 'Модули')));
        $reqRaw = $value['req'] ?? false;

        if ($key === '' || $label === '' || !preg_match('/^[a-z0-9_\-]{1,64}$/', $key)) {
            return null;
        }

        if (!in_array($moduleSet, ['common', 'payment', 'custom'], true)) {
            $moduleSet = 'common';
        }

        return [
            'k' => $key,
            'l' => $label,
            'module_set' => $moduleSet,
            'module_title' => $moduleTitle !== '' ? $moduleTitle : 'Модули',
            'req' => is_bool($reqRaw) ? $reqRaw : in_array(strtolower((string) $reqRaw), ['1', 'true', 'yes', 'on'], true),
            'custom_modules' => $this->stringArray($value['custom_modules'] ?? ($value['m'] ?? []), 200, 255),
            'custom_statuses' => $this->stringArray($value['custom_statuses'] ?? ($value['s'] ?? []), 100, 255),
        ];
    }

    protected function buildWidgetUiConfig(array $canonical): array
    {
        $canonical = $this->normalizeConfigCanonical($canonical);
        $common = $canonical['common_modules'];
        $payment = $canonical['payment_topics'];
        $statuses = $canonical['unified_statuses'];
        $reasonsUi = [];

        foreach ($canonical['reasons'] as $reason) {
            $moduleSet = (string) ($reason['module_set'] ?? 'common');
            $modules = $moduleSet === 'payment'
                ? $payment
                : ($moduleSet === 'custom'
                    ? $this->stringArray($reason['custom_modules'] ?? [], 200, 255)
                    : $common);

            $reasonStatuses = $this->stringArray($reason['custom_statuses'] ?? [], 100, 255);

            if (!$modules) {
                $modules = $common;
            }

            if (!$reasonStatuses) {
                $reasonStatuses = $statuses;
            }

            $reasonsUi[] = [
                'k' => (string) $reason['k'],
                'l' => (string) $reason['l'],
                'mTitle' => (string) $reason['module_title'],
                'm' => $modules,
                's' => $reasonStatuses,
                'req' => (bool) ($reason['req'] ?? false),
            ];
        }

        return [
            'version' => 1,
            'commonModules' => $common,
            'paymentTopics' => $payment,
            'unifiedStatuses' => $statuses,
            'reasons' => $reasonsUi,
        ];
    }

    protected function resolveReasonConfig(array $config, string $reasonKey): ?array
    {
        foreach ((array) ($config['reasons'] ?? []) as $reason) {
            if ((string) ($reason['k'] ?? '') === $reasonKey) {
                return $reason;
            }
        }

        return null;
    }

    protected function normalizeSelectedModules($value, array $allowedModules): array
    {
        return $this->stringArray(is_array($value) ? $value : [], 50, 255);
    }

    protected function buildManualCallIdentifier($call): string
    {
        $parts = [parse_url(config('app.url'), PHP_URL_HOST), 'call', (string) ($call->id ?? '')];

        if (!empty($call->uuid)) {
            $parts[] = (string) $call->uuid;
        }

        return implode(':', array_filter($parts));
    }

    protected function buildSummaryText($call, array $reason, array $modules, string $status, string $comment, $actor = null): string
    {
        $lines = [
            'ОПРОС ПО ЗВОНКУ',
            'Причина: ' . ($reason['l'] ?? '-'),
            ($reason['mTitle'] ?? 'Модули') . ': ' . ($modules ? implode(', ', $modules) : 'не выбрано'),
            'Статус: ' . ($status !== '' ? $status : '-'),
            'Телефон: ' . ((string) ($call->client_telephone ?? '-')),
            'Дата звонка: ' . ((string) ($call->created_at ?? '-')),
        ];

        if (!empty($actor->name)) {
            $lines[] = 'Заполнил: ' . $actor->name;
        }

        $lines[] = 'Комментарий: ' . ($comment !== '' ? $comment : '-');

        return implode("\n", $lines);
    }

    protected function stringArray($value, int $maxItems = 100, int $maxLen = 255): array
    {
        if (!is_array($value)) {
            return [];
        }

        $out = [];

        foreach ($value as $item) {
            $text = trim((string) $item);

            if ($text === '') {
                continue;
            }

            $text = $this->limitString($text, $maxLen);

            if (!in_array($text, $out, true)) {
                $out[] = $text;
            }

            if (count($out) >= $maxItems) {
                break;
            }
        }

        return $out;
    }

    protected function limitString($value, int $maxLength): string
    {
        $text = is_string($value) ? $value : (string) $value;

        if ($maxLength <= 0) {
            return '';
        }

        if (function_exists('mb_substr')) {
            return (string) mb_substr($text, 0, $maxLength);
        }

        return substr($text, 0, $maxLength);
    }
